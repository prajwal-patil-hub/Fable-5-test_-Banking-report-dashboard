# Sovereign backend configuration (all optional — sensible defaults built in).
# Copy to .env or export as environment variables. Prefix: SOVEREIGN_

# --- Database -----------------------------------------------------------
# Default: local SQLite file. Point at PostgreSQL in production.
# SOVEREIGN_DATABASE_URL=sqlite:///./sovereign.db
# PostgreSQL / Supabase (install driver: pip install -e ".[postgres]"):
# SOVEREIGN_DATABASE_URL=postgresql+psycopg://user:pass@localhost/sovereign
# SOVEREIGN_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Demo data ----------------------------------------------------------
# Seed 4 synthetic demo banks x 3 fiscal years on first boot (default: true).
# SOVEREIGN_SEED_DEMO_DATA=true

# --- Security (demo-grade; front with SSO/OIDC in production) ------------
# If set, every /api request must send a matching X-API-Key header.
# SOVEREIGN_API_KEY=change-me

# --- Currency display layer ----------------------------------------------
# INR per USD used when the dashboard requests currency=usd (default 83.5).
# SOVEREIGN_USD_INR_RATE=83.5

# --- LLM fallback extraction (off by default; deterministic-first) --------
# SOVEREIGN_LLM_EXTRACTION_ENABLED=false
#
# Provider "anthropic" (default): needs pip install -e ".[llm]" and
#   ANTHROPIC_API_KEY in the environment. Model default: claude-sonnet-5.
# Provider "ollama": local model, no API key, no extra Python deps.
#   Model default: llama3.1:8b (pull it first: `ollama pull llama3.1:8b`).
# Provider "openai_compatible": any /chat/completions endpoint — e.g.
#   Zhipu GLM cloud (get a key at open.bigmodel.cn):
# SOVEREIGN_LLM_PROVIDER=openai_compatible
# SOVEREIGN_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# SOVEREIGN_LLM_API_KEY=your-glm-key
# SOVEREIGN_LLM_MODEL=glm-4-flash
# SOVEREIGN_LLM_PROVIDER=ollama
# SOVEREIGN_LLM_MODEL=llama3.1:8b    # or glm4 for local GLM
# SOVEREIGN_OLLAMA_BASE_URL=http://localhost:11434
